= val_pred\n","    cat_test_pred += test_pred / N_SPLITS\n","    cat_models.append(model)\n","\n","    fold_auc = roc_auc_score(y_val, val_pred)\n","    fold_logloss = log_loss(y_val, val_pred)\n","\n","    cat_fold_results.append({\n","        \"fold\": fold,\n","        \"ROC-AUC\": fold_auc,\n","        \"LogLoss\": fold_logloss,\n","        \"best_iteration\": model.get_best_iteration(),\n","    })\n","\n","    print(f\"Fold {fold} ROC-AUC: {fold_auc:.6f}\")\n","    print(f\"Fold {fold} LogLoss: {fold_logloss:.6f}\")\n","\n","cat_fold_results_df = pd.DataFrame(cat_fold_results)\n","\n","cat_oof_metrics = evaluate_binary_model(\n","    \"CatBoost 5-Fold OOF\",\n","    y,\n","    cat_oof_pred\n",")\n","\n","display(cat_fold_results_df)\n","display(pd.DataFrame([cat_oof_metrics]).set_index(\"model\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"U_tlRQpOZxl5","executionInfo":{"status":"ok","timestamp":1780031180429,"user_tz":-540,"elapsed":240525,"user":{"displayName":"박빛샘","userId":"07736325174228252552"}},"outputId":"184e40ef-382b-42d1-8e49-eceb9925c870"},"execution_count":29,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","========== Fold 1 ==========\n","0:\ttest: 0.7132302\tbest: 0.7132302 (0)\ttotal: 965ms\tremaining: 48m 15s\n","200:\ttest: 0.7364304\tbest: 0.7364304 (200)\ttotal: 3m 6s\tremaining: 43m 14s\n","400:\ttest: 0.7374199\tbest: 0.7374199 (400)\ttotal: 6m 5s\tremaining: 39m 28s\n","600:\ttest: 0.7379345\tbest: 0.7379367 (598)\ttotal: 9m 18s\tremaining: 37m 10s\n","800:\ttest: 0.7381368\tbest: 0.7381368 (800)\ttotal: 12m 33s\tremaining: 34m 28s\n","1000:\ttest: 0.7382568\tbest: 0.7382573 (999)\ttotal: 15m 44s\tremaining: 31m 26s\n","1200:\ttest: 0.7382778\tbest: 0.7382896 (1178)\ttotal: 18m 58s\tremaining: 28m 25s\n","1400:\ttest: 0.7382519\tbest: 0.7382930 (1324)\ttotal: 22m 12s\tremaining: 25m 20s\n","Stopped by overfitting detector  (200 iterations wait)\n","\n","bestTest = 0.7382930324\n","best